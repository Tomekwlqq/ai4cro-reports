<script>
var _TAB_ORDER = ["v-hp_desktop", "v-listing_desktop", "v-pdp_desktop", "v-fixes", "v-notes"];
function show(id, btn){
  document.querySelectorAll('.tab').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('section.view').forEach(s=>s.classList.remove('on'));
  document.getElementById(id).classList.add('on');
  var st = document.querySelector('#' + id + ' .stab');
  if (st) show_sub(id, st, st.dataset.stab || 'order');
  window.scrollTo({top:0,behavior:'smooth'});
}
function show_sub(id, btn, sub){
  var box = document.getElementById(id);
  if (!box) return;
  box.querySelectorAll('.stab').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  box.querySelectorAll('.subview').forEach(s=>s.style.display = s.dataset.sub === sub ? '' : 'none');
}
function go(id){
  var tabs = document.querySelectorAll('.tab');
  var i = _TAB_ORDER.indexOf(id);
  tabs[Math.max(0,i)].click();
}
function hashNav(){
  var h = location.hash;
  if (!h) return;
  var id = h.slice(1);
  var tgt = document.getElementById(id);
  if (!tgt) return;
  if (tgt.classList && tgt.classList.contains('view')){
    go(id); return;
  }
  var sec = tgt.closest ? tgt.closest('section.view') : null;
  if (sec) {
    go(sec.id);
    setTimeout(function(){
      tgt.scrollIntoView({behavior:'smooth',block:'center'});
      var orig = tgt.style.outline;
      tgt.style.outline = '3px solid var(--v)';
      tgt.style.outlineOffset = '4px';
      tgt.style.transition = 'outline .15s';
      setTimeout(function(){ tgt.style.outline = orig; tgt.style.outlineOffset = ''; }, 2000);
    }, 200);
  }
}
window.addEventListener('DOMContentLoaded', hashNav);
window.addEventListener('hashchange', hashNav);
function seqGo(vid, n){
  var box=document.getElementById('seq-'+vid); if(!box) return;
  var row=box.querySelector('tr.seq-row[data-n="'+n+'"]'); if(!row) return;
  var H=parseFloat(box.dataset.h), sh=box.querySelector('.seq-shot'), img=sh.querySelector('img'), hl=sh.querySelector('.seq-hl');
  var k=img.clientHeight/H, y=parseFloat(row.dataset.top)*k, h=Math.max(parseFloat(row.dataset.hgt)*k,18);
  hl.style.top=y+'px'; hl.style.height=h+'px'; hl.style.display='block';
  sh.scrollTo({top:Math.max(y-40,0),behavior:'smooth'});
  box.querySelectorAll('tr.seq-row.on').forEach(function(r){r.classList.remove('on')}); row.classList.add('on');
  var rb=row.getBoundingClientRect(); if(rb.top<70||rb.bottom>window.innerHeight) row.scrollIntoView({block:'center',behavior:'smooth'});
}
function openOverlay(src){
  document.getElementById('overlay-img').src = src;
  document.getElementById('overlay').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeOverlay(){
  document.getElementById('overlay').classList.remove('active');
  document.body.style.overflow = '';
}
// Klik na tło (overlay) zamyka — jak w build_vision_report_v5.py
document.addEventListener('click', function(e){
  var overlay = document.getElementById('overlay');
  if (e.target === overlay) closeOverlay();
});
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeOverlay(); });
</script>

