<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UX audit — CHINASELECT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#FBF6F1;--surface:#FFFFFF;--ink:#2B2326;--muted:#6B5D5A;--faint:#9C8D88;--line:#EFE3DA;--line-soft:#F4EBE4;
--v:#C9A84C;--v-d:#8A6D1F;--v-soft:rgba(201,168,76,.10);--v-line:rgba(201,168,76,.32);
--green:#16a34a;--green-d:#15803d;--green-soft:#e7f6ec;--green-line:#b7e3c4;
--orange:#f5751a;--orange-soft:#fff2e8;--orange-line:#f8c39a;
--blue:#0f7ae5;--blue-d:#0a63bd;--blue-soft:#e9f3fd;--blue-line:#a9d2f6;
--amber:#b8862b;--amber-d:#9a6f1f;--amber-soft:#fdf5e6;--amber-line:#e9d3a3;
--red:#dc2626;--red-soft:#fee2e2;--dark:#1a1f2b;
--grotesk:'Space Grotesk',system-ui,sans-serif;--mono:'IBM Plex Mono','SF Mono',Menlo,monospace}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--grotesk);background:var(--bg);color:var(--ink);font-size:14px;line-height:1.65;-webkit-font-smoothing:antialiased}
.top{position:sticky;top:0;z-index:50;background:rgba(251,246,241,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top-in{max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:18px;padding:13px 28px;flex-wrap:wrap}
.back{font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:8px;padding:6px 12px;text-decoration:none;white-space:nowrap}
.back:hover{color:var(--v);border-color:var(--v-line);background:var(--v-soft)}
.seg{display:flex;gap:6px}
.seg-b{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--muted);border:1px solid var(--line);border-radius:8px;padding:6px 12px;white-space:nowrap;cursor:default}
.seg-b.ux{color:var(--green-d);border-color:var(--green-line)}
.seg-b.ux.on{background:var(--green);border-color:var(--green);color:#fff}
.seg-b.tech{color:var(--amber);border-color:var(--amber-line)}
.seg-b.tech.on{background:var(--amber);border-color:var(--amber);color:#fff}
.top-t{font-size:14px;font-weight:600}
.top-t span{color:var(--faint);font-weight:400}
.top-nav{margin-left:auto;font-family:var(--mono);font-size:11px;display:flex;gap:6px;flex-wrap:wrap}
.tnav{text-decoration:none;color:var(--muted);padding:5px 10px;border-radius:6px;cursor:pointer;background:none;border:none;font-family:var(--mono);font-size:11px}
.tnav:hover{background:var(--v-soft);color:var(--v-d)}
.tnav.on{background:var(--v);color:#fff}
.wrap{max-width:1000px;margin:0 auto;padding:44px 28px 90px}
.kicker{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--v);margin-bottom:14px;font-weight:600}
h1{font-size:clamp(30px,4.4vw,44px);font-weight:700;letter-spacing:-.03em;line-height:1.15;margin-bottom:10px}
.sub{color:var(--muted);font-size:17.5px;margin-bottom:26px}
.meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:30px}
.chip{font-family:var(--mono);font-size:11.5px;padding:5px 11px;border:1px solid var(--line);border-radius:99px;color:var(--muted);background:#fff}
.chip b{color:var(--ink);font-weight:600}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 30px}
.tab{font-family:var(--mono);font-size:12px;font-weight:600;padding:8px 16px;border:1px solid var(--t-line,var(--line));border-radius:99px;background:#fff;color:var(--t-d,var(--muted));cursor:pointer;transition:border-color .12s,color .12s}
.tab:hover{border-color:var(--t,var(--v));color:var(--t-d,var(--v-d))}
.tab.on{background:var(--t,var(--v));border-color:var(--t,var(--v));color:#fff}
.tab.c1{--t:#C9A84C;--t-d:#8A6D1F;--t-line:rgba(201,168,76,.32)}
.tab.c2{--t:#0f7ae5;--t-d:#0a63bd;--t-line:#a9d2f6}
.tab.c3{--t:#16a34a;--t-d:#15803d;--t-line:#b7e3c4}
.tab.c4{--t:#f5751a;--t-d:#dd5e0a;--t-line:#f8c39a}
.tab.c5{--t:#b8862b;--t-d:#9a6f1f;--t-line:#e9d3a3}
.tab.c6{--t:#5E8C7E;--t-d:#3F6B62;--t-line:rgba(94,140,126,.32)}
.tab.c7{--t:#0f7ae5;--t-d:#0a63bd;--t-line:#a9d2f6}
.tab.c8{--t:#16a34a;--t-d:#15803d;--t-line:#b7e3c4}
.tab.c9{--t:#f5751a;--t-d:#dd5e0a;--t-line:#f8c39a}
section.view{display:none}
section.view.on{display:block}
h2{font-size:26px;font-weight:700;margin:40px 0 6px;display:flex;align-items:baseline;gap:12px;letter-spacing:-.02em}
h2 .n{font-family:var(--mono);font-size:14px;color:var(--v);font-weight:500}
.sec-lead{color:var(--muted);margin-bottom:18px;font-size:14px}
h3{font-size:16px;font-weight:700;margin:26px 0 10px}
table{width:100%;border-collapse:collapse;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin:12px 0 8px;font-size:14px}
th{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);background:#fafbfd;text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);font-weight:500}
td{padding:9px 12px;border-bottom:1px solid var(--line);color:var(--muted);vertical-align:top}
tr:last-child td{border-bottom:none}
td.nm{color:var(--ink);font-weight:600}
.etyk{font-weight:600;color:var(--ink)}
.role{font-family:var(--mono);font-size:10.5px;color:var(--faint);text-transform:uppercase;letter-spacing:.04em}
.obs{color:var(--v-d);background:var(--v-soft)}
.pos{font-family:var(--mono);font-size:12px;color:var(--faint);white-space:nowrap}
.badge{font-family:var(--mono);font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:5px;white-space:nowrap;display:inline-block}
.badge.pass{background:var(--green-soft);color:var(--green-d);border:1px solid var(--green-line)}
.badge.weak{background:var(--orange-soft);color:var(--orange);border:1px solid var(--orange-line)}
.badge.fail{background:var(--red-soft);color:var(--red);border:1px solid #fca5a5}
.badge.check{background:#f1f5f9;color:#475569;border:1px solid var(--line)}
.badge.requires{background:#f1f5f9;color:#64748b;border:1px dashed var(--line);font-weight:500}
.verdict{font-family:var(--mono);font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:5px;white-space:nowrap;display:inline-block}
.verdict.up{background:var(--red-soft);color:var(--red)}
.verdict.keep{background:var(--green-soft);color:var(--green-d)}
.el-cell{display:flex;gap:12px;align-items:flex-start}
.crop-min{flex:0 0 96px;width:96px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#f3f4f6;display:block}
.crop-min img{width:100%;display:block}
.el-txt{flex:1;min-width:0}
.shots{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin:14px 0}
.shot{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}
.shot a{display:block}
.shot img{width:100%;display:block;max-height:230px;object-fit:cover;object-position:top}
.shot .cap{font-family:var(--mono);font-size:10.5px;color:var(--faint);padding:6px 10px;border-top:1px solid var(--line)}
.shot .cap b{color:var(--ink);font-weight:600}
.shot-full{display:inline-block;font-family:var(--mono);font-size:11.5px;color:var(--v-d);text-decoration:none;margin:4px 0 12px}
.shot-full:hover{text-decoration:underline}
.rec{border:1px solid var(--line);border-left:4px solid var(--v);border-radius:12px;padding:18px 22px;margin-bottom:16px;background:#fff}
.rec .rh{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:4px;flex-wrap:wrap}
.rec .rt{font-weight:700;font-size:15.5px}
.rec .prio{font-family:var(--mono);font-size:12px;font-weight:600;padding:3px 10px;border-radius:99px;background:var(--v-soft);color:var(--v-d)}
.rec .rw{font-size:13.5px;color:var(--muted);margin-bottom:12px}
.f5{display:grid;grid-template-columns:150px 1fr;gap:3px 16px;font-size:14px}
.f5 .fk{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--faint);padding-top:3px}
.f5 .fv{padding:3px 0;color:var(--ink)}
.f5 .fv b{font-weight:600}
ul.tick{list-style:none;margin:8px 0}
ul.tick li{padding:6px 0 6px 26px;position:relative;font-size:14.5px;color:var(--muted)}
ul.tick li::before{content:"";position:absolute;left:8px;top:14px;width:5px;height:5px;border-radius:50%;background:var(--v)}
.box{border:1px solid var(--line);border-radius:14px;background:#fafbfd;padding:20px 24px;margin:14px 0}
.box b{color:var(--ink)}
.box p{margin-top:10px;color:var(--muted);font-size:14.5px}
.box .br{display:block;margin-top:10px}
.foot{margin-top:60px;border-top:1px solid var(--line);padding-top:18px;font-family:var(--mono);font-size:11.5px;color:var(--faint);text-align:center}
.stabs{display:flex;gap:8px;margin:4px 0 16px;flex-wrap:wrap}
.stab{font-family:var(--mono);font-size:11.5px;font-weight:600;padding:7px 14px;border:1px solid var(--line);border-radius:99px;background:#fff;color:var(--muted);cursor:pointer}
.stab:hover{border-color:var(--v-line);color:var(--v-d)}
.stab.on{background:var(--v);border-color:var(--v);color:#fff}
.subview{min-height:60px}
/* ===== długi zrzut obszaru + kolejność (04.10) ===== */
.seqv{display:grid;grid-template-columns:minmax(260px,34%) 1fr;gap:16px;align-items:start;margin:12px 0}
.seq-shot{position:sticky;top:64px;max-height:calc(100vh - 90px);overflow-y:auto;border:1px solid var(--line);border-radius:12px;background:#f3f4f6;scroll-behavior:smooth}
.seq-in{position:relative}
.seq-in img{width:100%;display:block}
.seq-dot{position:absolute;left:6px;transform:translateY(-2px);min-width:22px;height:22px;padding:0 5px;border-radius:11px;background:var(--v);color:#fff;font:600 11px/22px var(--mono);text-align:center;cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.35)}
.seq-hl{position:absolute;left:0;right:0;border:3px solid var(--v);background:rgba(201,168,76,.14);border-radius:4px;display:none;pointer-events:none;transition:top .25s,height .25s}
.seq-tab table{margin-top:0}
tr.seq-row{cursor:pointer}
tr.seq-row:hover td{background:rgba(201,168,76,.06)}
tr.seq-row.on td{background:var(--v-soft)}
@media(max-width:900px){.seqv{grid-template-columns:1fr}.seq-shot{position:relative;top:0;max-height:60vh}}
/* ===== funkcja · etap · działanie (04.10) ===== */
.rola{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.rtag{font-family:var(--mono);font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:99px;border:1px solid var(--line);background:#fff;color:var(--muted)}
.rtag.etap{background:#f6f7f9}
.rtag.f-aktywuje{background:#fff2e8;color:#c2410c;border-color:#f8c39a}
.rtag.f-uwiarygadnia{background:#e7f6ec;color:#15803d;border-color:#b7e3c4}
.rtag.f-przekonuje{background:rgba(201,168,76,.10);color:#8A6D1F;border-color:rgba(201,168,76,.32)}
.rtag.f-informuje{background:#e9f3fd;color:#0a63bd;border-color:#a9d2f6}
.rtag.f-nawiguje,.rtag.f-orientuje{background:#f1f5f9;color:#475569}
.rtag.f-podtrzymuje{background:#fdf5e6;color:#9a6f1f;border-color:#e9d3a3}
.dzialanie{margin-top:10px;font-size:13.5px;color:var(--ink);line-height:1.45}
.dzialanie .elc-k{display:inline;margin-right:6px}
.dz-typ{font-family:var(--mono);font-size:10.5px;padding:1px 6px;border-radius:5px;background:#f1f5f9;color:#475569;white-space:nowrap}
.dz-typ.t-glowne{background:#fff2e8;color:#c2410c}
.dz-ev{display:block;font-family:var(--mono);font-size:10.5px;color:var(--faint);margin-top:3px}
td.typ .rola{margin-top:5px}
td.typ{font-family:var(--mono);font-size:11px;color:var(--faint)}
/* ===== karta elementu (02.10) ===== */
.elcards{display:flex;flex-direction:column;gap:18px;margin:14px 0}
.elc{border:1px solid var(--line);border-radius:14px;background:#fff;padding:16px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.elc-top{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:18px;align-items:start}
.elc-shot{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#f3f4f6}
.elc-shot img{width:100%;display:block;max-height:340px;object-fit:cover;object-position:top;cursor:zoom-in}
.elc-name{font-size:18px;font-weight:700;color:var(--ink);line-height:1.3;margin-bottom:4px}
.elc-side .rscore{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.elc-k{font-family:var(--mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);margin-bottom:4px}
.elc-found{margin-top:14px;font-size:13.5px;line-height:1.55;color:var(--ink)}
.elc-ex{margin-top:12px;font-size:14px;color:var(--muted);border-left:3px solid var(--v-line);padding-left:12px}
.badge.klik{background:#eff6ff;color:#1d4ed8;border:1px dashed #93c5fd}
table.rtab{margin:0;border:none;border-radius:0;font-size:13px}
table.rtab td{padding:7px 10px;color:var(--ink)}
table.rtab td.rnote{color:var(--muted)}
table.rtab tr.v-check td{opacity:.6}
@media(max-width:900px){.elc-top{grid-template-columns:1fr}.elc{padding:12px}}
/* ===== rules from library — acc-gold/slate, zwijany ===== */
details.rulebox{margin-top:10px;border:1px solid var(--v-line);border-radius:10px;background:var(--v-soft);overflow:hidden;transition:box-shadow .15s}
details.rulebox:hover{border-color:var(--v);box-shadow:0 2px 10px rgba(201,168,76,.12)}
details.rulebox summary{cursor:pointer;list-style:none;padding:10px 14px;font-size:12.5px;color:var(--v-d);font-weight:700;display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:linear-gradient(90deg,rgba(201,168,76,.08),transparent 60%)}
details.rulebox summary::-webkit-details-marker{display:none}
details.rulebox summary .chev{flex:0 0 auto;width:18px;height:18px;border-radius:5px;background:var(--v);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;transition:transform .18s;line-height:1}
details.rulebox[open] summary .chev{transform:rotate(90deg)}
details.rulebox summary .rl{flex:1;min-width:0}
details.rulebox summary .rs{font-family:var(--mono);font-size:10.5px;font-weight:500;color:var(--muted);margin-left:auto;text-align:right}
details.rulebox .rbody{padding:2px 14px 14px}
.rlvl{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:10px 0 4px;font-weight:600}
.rlvl:first-child{margin-top:6px}
.rule{display:flex;gap:8px;align-items:flex-start;padding:4px 0;font-size:12.5px;color:var(--ink);line-height:1.45;border-top:1px dashed var(--v-line)}
.rule:first-of-type{border-top:none}
.rule .rid{font-family:var(--mono);font-size:10px;color:var(--v-d);white-space:nowrap;padding-top:1px}
.rule .rtx{flex:1;min-width:0}
.rule .rc{font-family:var(--mono);font-size:9.5px;color:var(--faint);white-space:nowrap;padding-top:1px}
.rnote{font-size:11.5px;color:var(--muted);padding:2px 0 4px 30px;border-top:1px dashed var(--v-line);margin-top:1px}
.rscore{display:flex;flex-wrap:wrap;gap:3px;margin-top:6px}
.uxbox{margin:14px 0 20px;border:1px solid var(--green-line);border-radius:12px;background:linear-gradient(135deg,var(--green-soft),#fff);overflow:hidden}
.uxbox summary{display:flex;align-items:center;gap:10px;padding:12px 16px;cursor:pointer;font-family:var(--mono);font-size:11.5px;color:var(--green-d);font-weight:600}
.uxbox summary .chev{transition:transform .15s;color:var(--green-d)}
.uxbox[open] summary .chev{transform:rotate(90deg)}
.uxbox .uxl{font-size:12.5px;letter-spacing:.02em}
.uxbox .uxs{margin-left:auto;font-size:10.5px;color:var(--green-d);background:var(--green-soft);border:1px solid var(--green-line);border-radius:99px;padding:3px 10px}
.uxlist{margin:0;padding:0 16px 14px;list-style:none}
.uxlist li.uxp{position:relative;padding:6px 0 6px 26px;font-size:13.5px;color:var(--ink);line-height:1.5}
.uxlist li.uxp::before{content:"";position:absolute;left:6px;top:13px;width:7px;height:7px;border-radius:50%;background:var(--green)}
.uxlist .uxk{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--green-d);display:block;margin-bottom:1px}
.uxm{margin:0 16px 14px;font-size:11px;color:var(--muted);font-family:var(--mono);border-top:1px dashed var(--green-line);padding-top:8px}
/* ===== overlay — wycinki otwierane na miejscu, nie w nowej karcie =====
   Wzorzec (klik w tło + Escape + widoczny X): scripts/build_vision_report_v5.py
   .overlay / .overlay-close / openOverlay() / closeOverlay() — ten sam generator-rodzina.
   Tu: overlay-box przystosowany pod pełnoekranowy obraz (źródło miało białą kartę na tekst)
   + scroll-lock body na czas otwarcia (nowy wymóg, źródło go nie miało). Kolory z palety
   tego pliku (--line/--ink/--mono/--v), nie z hardkodów źródła. */
.shot img,.crop-min img,.shot-full{cursor:pointer}
.overlay{position:fixed;inset:0;background:rgba(10,10,10,.92);z-index:999;display:none;align-items:center;justify-content:center;padding:20px}
.overlay.active{display:flex}
.overlay-box{position:relative;max-width:94vw;max-height:90vh}
.overlay-box img{max-width:94vw;max-height:90vh;display:block;border-radius:8px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.overlay-close{position:fixed;top:16px;right:16px;width:44px;height:44px;border-radius:50%;background:#fff;border:1px solid var(--line);color:var(--ink);font-family:var(--mono);font-size:20px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:1000}
.overlay-close:hover{border-color:var(--v);color:var(--v-d)}
@media(max-width:480px){.overlay-close{top:10px;right:10px;width:40px;height:40px;font-size:18px}}

@media(max-width:900px){
  .top-nav{display:none}
  .wrap{padding:28px 16px 60px}
  h1{font-size:28px}
  .sub{font-size:16px}
  .f5{grid-template-columns:1fr}
  .f5 .fk{padding-top:6px}
  table,thead,tbody,tr,th,td{display:block;width:100%}
  thead{display:none}
  tr{border-bottom:1px solid var(--line);padding:6px 0}
  tr:last-child{border-bottom:none}
  td{border:none;padding:4px 12px;width:100%}
  .rec{padding:14px 16px}
}
</style>
</head>
